---
// Celebrating 20 Years. Copy is in src/content-data/twenty-years.json (see src/data/twenty-years.ts).
// Linked from the footer and Home hero slide 2 only, not from the main navigation.
// No names or faces of individuals, no committee list and no directors list are published here.
import Media from '../components/Media.astro';
import PageHero from '../components/PageHero.astro';
import { school } from '../data/school';
import { twentyYears } from '../data/twenty-years';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/twenty-years.css';

const { week, foundation, gallery, next } = twentyYears;
---

<BaseLayout title={`${twentyYears.title} | ${school.name}`} description={twentyYears.lead}>
  <PageHero
    title={twentyYears.title}
    lead={twentyYears.lead}
    note={twentyYears.eventLine}
    crumbs={[{ label: twentyYears.title }]}
    display
  />

  <section class="ty-section" aria-labelledby="week-heading">
    <div class="bc-wrap">
      <h2 id="week-heading" class="ty-h2">{week.heading}</h2>
      <ul class="week-list">
        {week.items.map((item) => <li><h3>{item}</h3></li>)}
      </ul>
    </div>
  </section>

  <section class="bc-section-navy ty-section" aria-labelledby="foundation-heading">
    <div class="bc-wrap foundation">
      <div class="foundation-copy">
        <h2 id="foundation-heading" class="ty-h2">{foundation.heading}</h2>
        {foundation.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="foundation-note navy-muted">{foundation.note}</p>
      </div>
      <Media
        photo={foundation.photo}
        ratio="4 / 3"
        focus={foundation.focus}
        sizes="(min-width: 1264px) 480px, (min-width: 960px) 40vw, 100vw"
      />
    </div>
  </section>

  {
    gallery.slots.length > 0 && (
      <section class="ty-section ty-tint" aria-labelledby="gallery-heading">
        <div class="bc-wrap">
          <h2 id="gallery-heading" class="ty-h2">{gallery.heading}</h2>
          <div class="gallery-grid">
            {gallery.slots.map((slot) => (
              <Media
                photo={slot.photo}
                ratio="1 / 1"
                focus={slot.focus}
                tag="[SAMPLE]"
                sizes="(min-width: 1264px) 282px, (min-width: 720px) 25vw, 50vw"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="ty-section" aria-labelledby="next-heading">
    <div class="bc-wrap">
      <div class="next-chapter">
        <h2 id="next-heading" class="ty-h2">{next.heading}</h2>
        <a class="bc-btn bc-btn-primary" href={next.href}>{next.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
