---
// Home: "Home Fuller – Full Hero". All copy is in src/content-data/home.json (see src/data/home.ts);
// the numbers band is computed from the results and the founding year.
import { getImage } from 'astro:assets';
import HeroCarousel from '../components/HeroCarousel.astro';
import Media from '../components/Media.astro';
import Motif from '../components/Motif.astro';
import PhotoFill from '../components/PhotoFill.astro';
import Tag from '../components/Tag.astro';
import { admissions } from '../data/admissions';
import { contact, whatsappHref } from '../data/contact';
import { heroImage, homePage } from '../data/home';
import { cta } from '../data/nav';
import { formatPercent, latestResult } from '../data/results';
import { samplePhotos } from '../data/sample-content-register';
import { school, yearsSinceFounding } from '../data/school';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const { hero, welcome, science, dayBoarding, proof, closing } = homePage;

const latest = latestResult();
const stats = [
  { value: String(yearsSinceFounding()), label: `years of teaching, since ${school.foundedYear}` },
  { value: formatPercent(latest.wassce ?? 0), label: `WASSCE pass rate, ${latest.year} [DRAFT · CONFIRM measure]` },
  { value: formatPercent(latest.universityAdmission ?? 0, 0), label: `university admission, ${latest.year} [DRAFT]` },
];

// Preload the first slide's photo (and only that one). The srcset comes from the same call the
// <img> uses, so the preload and the image fetch the very same file.
const firstPhoto = samplePhotos[hero.slides[0].photo].image;
const preload = await getImage({ src: firstPhoto, widths: heroImage.widths, sizes: heroImage.sizes, format: 'webp' });
---

<BaseLayout title="Busarialao College: Nurturing Scientific Minds, Inspiring the Future" description={hero.slides[0].text}>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={preload.srcSet.attribute}
    imagesizes={heroImage.sizes}
    fetchpriority="high"
  />

  <HeroCarousel label={hero.label} slides={hero.slides} autoplay={hero.autoplay} />

  <section class="home-section home-tint" aria-labelledby="welcome-heading">
    <div class="bc-wrap home-split">
      <div class="home-stack">
        <h2 id="welcome-heading" class="home-h2 home-h2-lg">{welcome.heading}</h2>
        <Tag text={welcome.headingTag} />
      </div>
      <div class="home-stack">
        <p class="welcome-text">{welcome.text}</p>
        <Tag text={welcome.textTag} />
        <a class="home-link" href={welcome.linkHref}>{welcome.linkLabel}</a>
      </div>
    </div>
  </section>

  <section class="bc-section-navy home-numbers" aria-labelledby="numbers-heading">
    <Motif />
    <div class="bc-wrap home-numbers-inner">
      <h2 id="numbers-heading" class="sr-only">Our record</h2>
      <ul class="home-stats">
        {
          stats.map((stat) => (
            <li>
              <span class="home-stat-value">{stat.value}</span>
              <span class="home-stat-label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
      <a class="home-results-link" href={cta.results}>{homePage.numbersLinkLabel}</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="science-heading">
    <div class="bc-wrap">
      <div class="science-head">
        <h2 id="science-heading" class="home-h2">{science.heading}</h2>
        <Tag text={science.headingTag} />
        <p class="home-sub">{science.lead}</p>
      </div>
      <Media
        photo={science.photo}
        ratio={science.ratio}
        ratioMobile={science.ratioMobile}
        focus={science.focus}
        sizes="(min-width: 1264px) 1200px, 100vw"
      />
      <div class="science-details">
        <div>
          <h3 class="bc-h3">{science.labsHeading}</h3>
          <Tag text={science.labsTag} />
          <dl class="lab-list">
            {
              science.labs.map((lab) => (
                <>
                  <dt>{lab.name}</dt>
                  <dd>{lab.text}</dd>
                </>
              ))
            }
          </dl>
          <p class="bc-muted">{science.labsNote}</p>
        </div>
        <div>
          <h3 class="bc-h3">{science.examsHeading}</h3>
          <p class="welcome-text science-exams">{science.examsText}</p>
          <p class="bc-muted">{science.examsNote}</p>
        </div>
      </div>
      <a class="home-link science-link" href={science.linkHref}>{science.linkLabel}</a>
    </div>
  </section>

  <section class="home-section home-tint" aria-labelledby="paths-heading">
    <div class="bc-wrap">
      <h2 id="paths-heading" class="home-h2 paths-title">{dayBoarding.heading}</h2>
      <div class="paths">
        {
          dayBoarding.items.map((item) => (
            <article>
              <Media
                photo={item.photo}
                ratio={item.ratio}
                focus={item.focus}
                sizes="(min-width: 1264px) 584px, (min-width: 600px) 50vw, 100vw"
              />
              <div>
                <h3 class="bc-h3">{item.title}</h3>
                <p class="home-sub">{item.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="proof-heading">
    <div class="bc-wrap home-split">
      <div class="home-stack">
        <h2 id="proof-heading" class="home-h2">{proof.heading}</h2>
        <Tag text={proof.headingTag} />
      </div>
      <div>
        <ul class="proof-list">
          {
            proof.items.map((item) => (
              <li>
                <p>{item.text}</p>
                {item.tag && <span class="bc-muted">{item.tag}</span>}
              </li>
            ))
          }
        </ul>
        <div class="proof-links">
          {proof.links.map((link) => <a class="home-link" href={link.href}>{link.label}</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="home-closing" aria-labelledby="closing-heading">
    <div class="closing-photo" aria-hidden="true">
      <PhotoFill
        photo={closing.photo}
        focus={closing.focus}
        focusMobile={closing.focusMobile}
        sizes="100vw"
        widths={[768, 1280, 1600]}
        alt=""
      />
    </div>
    <span class="closing-label">[SAMPLE] Generated photo</span>
    <div class="bc-wrap closing-inner">
      <div class="closing-copy">
        <h2 id="closing-heading" class="home-h2">{closing.heading}</h2>
        <p>{contact.tours}</p>
        <div class="closing-actions">
          <a class="bc-btn bc-btn-primary" href={closing.tourHref}>{closing.tourLabel}</a>
          <a class="home-link" href={closing.applyHref}>{closing.applyLabel}</a>
          <a class="home-link" href={whatsappHref()}>{closing.whatsappLabel}</a>
        </div>
      </div>
      <ol class="closing-steps">
        {
          admissions.joinSummary.map((step, index) => (
            <li>
              <h3>
                <span aria-hidden="true">{index + 1}</span>
                {step.title}
              </h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <a class="home-link closing-more" href={closing.stepsLinkHref}>{closing.stepsLinkLabel}</a>
    </div>
  </section>
</BaseLayout>
