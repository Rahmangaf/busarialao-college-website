---
// Site footer for the v1 pages. Desktop: logo row, four columns (School, Admissions, Find us, Contact),
// hairline and a small copyright row. Mobile: Contact first, then School and Admissions as
// collapsible rows; links never break across lines. Text and links are in src/content-data/site.json.
import '../../styles/v1/shell.css';
import { site } from '../../data/site';

const f = site.footer;
const icons: Record<string, { viewBox: string; fill: boolean; paths: string[] }> = {
  facebook: {
    viewBox: '0 0 24 24',
    fill: true,
    paths: [
      'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
    ],
  },
  instagram: { viewBox: '0 0 24 24', fill: false, paths: [] },
  whatsapp: {
    viewBox: '0 0 24 24',
    fill: true,
    paths: [
      'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z',
    ],
  },
};
const external = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---

<footer class="sf" data-site-footer>
  <div class="sf-card">
    <!-- Desktop -->
    <div class="sf-d">
      <div class="sf-top">
        <img class="sf-logo" src="/logo/logo.svg" alt={f.logoAlt} width="116" height="60" />
        <p class="sf-blurb">{f.blurb}</p>
        <div class="sf-soc">
          {
            f.socials.map((s) => (
              <a class={s.key} href={s.href} aria-label={s.label} {...external(s.href)}>
                {s.key === 'instagram' ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
                    <circle cx="12" cy="12" r="4.3" />
                    <circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" stroke="none" />
                  </svg>
                ) : (
                  <svg viewBox={icons[s.key].viewBox} fill="currentColor" aria-hidden="true">
                    <path d={icons[s.key].paths[0]} />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="sf-cols">
        <div>
          <h5>{f.school.heading}</h5>
          <ul>{f.school.links.map((l) => <li><a class="sf-link" href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <h5>{f.admissions.heading}</h5>
          <ul>{f.admissions.links.map((l) => <li><a class="sf-link" href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <h5>{f.findUs.heading}</h5>
          <ul>
            <li>
              <address class="sf-address">
                {f.findUs.address.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
              </address>
            </li>
            <li><a class="sf-link" href={f.findUs.directionsHref} {...external(f.findUs.directionsHref)}>{f.findUs.directionsLabel}</a></li>
            <li><span class="sf-pill"><i></i>{f.hours}</span></li>
          </ul>
        </div>
        <div>
          <h5>{f.contact.heading}</h5>
          <ul>
            <li><a class="sf-link" href={f.contact.phoneHref}>{f.contact.phone}</a></li>
            <li><a class="sf-link" href={f.contact.emailHref}>{f.contact.email}</a></li>
            <li><a class="sf-link" href={f.contact.portalHref}>{f.contact.portalLabel}</a></li>
          </ul>
        </div>
      </div>

      <div class="sf-bar">
        <span class="sf-bar-text">
          {f.legal.copyright} · <a href={f.legal.privacyHref}>{f.legal.privacyLabel}</a> · {f.legal.creditPrefix}
          <a href={f.legal.creditHref} target="_blank" rel="noopener">{f.legal.creditLabel}</a>
        </span>
        <a class="sf-top-link" href="#top">{f.legal.toTopLabel}</a>
      </div>
    </div>

    <!-- Mobile -->
    <div class="sf-m">
      <div class="sf-top">
        <img class="sf-logo" src="/logo/logo.svg" alt={f.logoAlt} width="104" height="54" />
        <p class="sf-blurb">{f.blurb}</p>
      </div>

      <div class="sf-contact">
        <h5>{f.contact.heading}</h5>
        <a class="sf-link" href={f.contact.phoneHref}>{f.contact.phone}</a>
        <a class="sf-link" href={f.contact.emailHref}>{f.contact.email}</a>
        <a class="sf-link" href={f.contact.whatsappHref}>{f.contact.whatsappLabel}</a>
        <div class="sf-addr-row">
          <address class="sf-address">
            {f.findUs.address.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
          </address>
        </div>
        <a class="sf-link directions" href={f.findUs.directionsHref} {...external(f.findUs.directionsHref)}>{f.findUs.directionsLabel}</a>
        <span class="sf-pill"><i></i>{f.hours}</span>
      </div>

      <div class="sf-rows">
        {
          [f.school, f.admissions].map((col) => (
            <details>
              <summary>
                {col.heading}
                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>
              <div class="sf-links">{col.links.map((l) => <a class="sf-link" href={l.href}>{l.label}</a>)}</div>
            </details>
          ))
        }
      </div>

      <div class="sf-soc">
        {
          f.socials.map((s) => (
            <a class={s.key} href={s.href} aria-label={s.label} {...external(s.href)}>
              {s.key === 'instagram' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
                  <circle cx="12" cy="12" r="4.3" />
                  <circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg viewBox={icons[s.key].viewBox} fill="currentColor" aria-hidden="true">
                  <path d={icons[s.key].paths[0]} />
                </svg>
              )}
            </a>
          ))
        }
      </div>

      <div class="sf-bar">
        <span class="sf-bar-text">
          {f.legal.copyright} · <a href={f.legal.privacyHref}>{f.legal.privacyLabel}</a>
          <span style="flex-basis:100%;height:0"></span>
          {f.legal.creditPrefix} <a href={f.legal.creditHref} target="_blank" rel="noopener">{f.legal.creditLabel}</a>
        </span>
        <a class="sf-top-link" href="#top">{f.legal.toTopLabel}</a>
      </div>
    </div>
  </div>
</footer>
