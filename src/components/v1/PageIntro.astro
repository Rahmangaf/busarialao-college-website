---
// Page opening: eyebrow, title, one line of lead text and up to two buttons.
// A "\n" in the title is a line break on wide screens only (it is a space on phones).
import V1Button from './V1Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  actions?: { label: string; href: string; kind?: 'primary' | 'secondary' }[];
  /** Cap the width of the title and lead, in characters (Academics and the other inner pages). */
  titleMax?: string;
  leadMax?: string;
}
const { eyebrow, title, lead, actions = [], titleMax, leadMax } = Astro.props;
const lines = title.split('\n');
---

<section class="intro">
  <div class="wrap">
    <slot name="before" />
    <span class="eb">{eyebrow}</span>
    <h1 class="h1" style={titleMax ? `max-width:${titleMax}` : undefined}>
      {lines.map((line, i) => (<>{i > 0 && <><br class="dbr" /><span class="dbr-gap"> </span></>}{line}</>))}
    </h1>
    {lead && <p class="lede muted" style={leadMax ? `max-width:${leadMax}` : undefined}>{lead}</p>}
    {actions.length > 0 && (
      <div class="actions">
        {actions.map((a) => <V1Button label={a.label} href={a.href} kind={a.kind} />)}
      </div>
    )}
    <slot />
  </div>
</section>
