---
// A photograph that fills its parent (the parent has class "ph": position relative, overflow hidden).
// Photos come from src/data/v1-photos.ts by key; Astro builds the responsive WebP sizes.
import { Image } from 'astro:assets';
import { photo } from '../../data/v1-photos';

interface Props {
  name: string;
  alt?: string;
  /** Where to centre the crop, for example "50% 30%". */
  focus?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
}
const { name, alt = '', focus, sizes = '(max-width: 700px) 100vw, 700px', widths = [480, 828, 1280], loading = 'lazy' } = Astro.props;
---

<Image src={photo(name)} alt={alt} widths={widths} sizes={sizes} loading={loading} style={focus ? `object-position:${focus}` : undefined} />
